# Dependencias
/node_modules

# Artefactos de compilación de Next.js
/.next/
/out/
/build

# Imágenes subidas en local por el administrador (en producción van a Vercel Blob)
/public/uploads

# Variables de entorno (NO subir secretos al repositorio)
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema
.DS_Store
*.pem

# Artefactos locales de trabajo (no versionar)
/Diseno-Paginas-PNG/
/Diseno-Tuterritorio.pdf
/Diseno-Tuterritorio-Oscuro.pdf
/tuterritorio-qr.png
/tuterritorio-qr-simple.png
/tuterritorio-qr.svg
*.docx
/Página Web de Tuterritorio - Historial de Versiones.pdf

# Skills de desarrollo (locales; enlaces con rutas absolutas no son portables)
/.agents/
/.claude/skills/*
!/.claude/skills/impeccable/

# Lockfile del CLI de skills (local)
/skills-lock.json
